{
  "name": "snacker-tracker-interface",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:graph": "aws s3 sync --delete s3://snacker-tracker-dev-shadow/data/ ../graph-data/data/ && SNACKER_PUBLIC_DATA=../graph-data vite",
    "build": "npm run contract:check && tsc -b && vite build",
    "lint": "npm run contract:check && oxlint",
    "contract": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check",
    "preview": "vite preview",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "react-vega": "^8.0.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
